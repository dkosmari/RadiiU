noinst_LTLIBRARIES += libimgui.la


libimgui_la_SOURCES = \
	custom_imconfig.h \
	imgui/backends/imgui_impl_sdl2.h \
	imgui/backends/imgui_impl_sdl2.cpp \
	imgui/backends/imgui_impl_sdlrenderer2.cpp \
	imgui/backends/imgui_impl_sdlrenderer2.h \
	imgui/imconfig.h \
	imgui/imgui.cpp \
	imgui/imgui.h \
	imgui/imgui_draw.cpp \
	imgui/imgui_internal.h \
	imgui/imgui_tables.cpp \
	imgui/imgui_widgets.cpp \
	imgui/imstb_rectpack.h \
	imgui/imstb_textedit.h \
	imgui/imstb_truetype.h \
	imgui/misc/cpp/imgui_raii.h \
	imgui/misc/cpp/imgui_stdlib.cpp \
	imgui/misc/cpp/imgui_stdlib.h

# Uncomment this to include Style Editor window.
libimgui_la_SOURCES += imgui/imgui_demo.cpp


libimgui_la_CPPFLAGS = \
	$(AM_CPPFLAGS) \
	-DIMGUI_USER_CONFIG='"$(srcdir)/custom_imconfig.h"' \
	-I$(srcdir)/imgui \
	$(SDL_CFLAGS)


if ENABLE_FREETYPE

libimgui_la_SOURCES += \
	imgui/misc/freetype/imgui_freetype.cpp \
	imgui/misc/freetype/imgui_freetype.h

libimgui_la_CPPFLAGS += \
	-DIMGUI_ENABLE_FREETYPE \
	$(FT_CFLAGS)

endif ENABLE_FREETYPE


if ENABLE_STB_TRUETYPE

libimgui_la_CPPFLAGS += -DIMGUI_ENABLE_STB_TRUETYPE

endif ENABLE_STB_TRUETYPE
